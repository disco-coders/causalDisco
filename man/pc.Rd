  pc_tetrad <- pc(
    engine = "tetrad",
    test = "fisher_z",
    alpha = 0.05,
    depth = 10,
    stable_fas = FALSE,
    collider_orientation_style = "sepsets",
    allow_bidirected = TRUE,
    fdr_q = 0.05
  )
  disco(tpc_example, pc_tetrad)
