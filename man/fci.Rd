    test = "fisher_z",
    alpha = 0.05,
    complete_rule_set_used = FALSE,
    max_disc_path_length = 4,
    depth = 10,
    stable_fas = FALSE,
    guarantee_pag = TRUE,
    collider_orientation_style = "sepsets",
    do_possible_dsep = FALSE,
    exclude_selection_bias = FALSE,
    fdr_q = 0.05
  )
  disco(tpc_example, fci_tetrad)
